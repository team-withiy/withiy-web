{
  "name": "withiy-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "run:local": "env-cmd -f env/.env.local -x next dev -p \\$PORT",
    "run:dev": "env-cmd -f env/.env.development -x next dev -p \\$PORT",
    "run:prod": "env-cmd -f env/.env.production -x next start -p \\$PORT",
    "build:local": "env-cmd -f env/.env.local next build",
    "build:dev": "env-cmd -f env/.env.development next build",
    "build:prod": "env-cmd -f env/.env.production next build",
    "start": "next start",
    "lint": "next lint",
    "prettier": "prettier --write . --ignore-unknown --check",
    "stylelint": "stylelint 'src/**/*.scss' --fix",
    "prepare": "husky",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "env-cmd -f env/.env.e2e concurrently \"next dev -p \\$PLAYWRIGHT_PORT\" \"wait-on \\$PLAYWRIGHT_BASE_URL && playwright codegen\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@faker-js/faker": "^9.7.0",
    "@hookform/resolvers": "^5.0.1",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@sentry/nextjs": "^9.12.0",
    "@tanstack/react-query": "^5.74.4",
    "clsx": "^2.1.1",
    "ky": "^1.8.1",
    "lodash-es": "^4.17.21",
    "next": "15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-loading-skeleton": "^3.5.0",
    "react-transition-group": "^4.4.5",
    "react-use": "^17.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.23.0",
    "@mdx-js/react": "^3.1.0",
    "@next/eslint-plugin-next": "^15.2.4",
    "@playwright/test": "^1.51.1",
    "@storybook/addon-essentials": "^8.6.11",
    "@storybook/addon-interactions": "^8.6.11",
    "@storybook/addon-onboarding": "^8.6.11",
    "@storybook/blocks": "^8.6.11",
    "@storybook/nextjs": "^8.6.11",
    "@storybook/react": "^8.6.11",
    "@storybook/test": "^8.6.11",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.68.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19.1.2",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "3.0.9",
    "@vitest/coverage-v8": "^3.0.9",
    "@vitest/ui": "^3.0.9",
    "concurrently": "^9.1.2",
    "cross-var": "^1.1.0",
    "dotenv": "^16.4.7",
    "env-cmd": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^0.12.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "msw": "2.7.4",
    "playwright": "^1.51.1",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "sass-embedded": "^1.86.0",
    "server-only": "^0.0.1",
    "storybook": "^8.6.11",
    "stylelint": "^16.16.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-declaration-strict-value": "^1.10.11",
    "stylelint-scss": "^6.11.1",
    "typescript": "^5",
    "typescript-eslint": "^8.28.0",
    "vite-plugin-magical-svg": "^1.6.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.9",
    "vitest-console": "^0.2.0",
    "vitest-fetch-mock": "^0.4.5",
    "wait-on": "^8.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
